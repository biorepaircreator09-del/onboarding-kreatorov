    { "brand": "biorepair", "level": "stop", "group": "Написание бренда", "pattern": "micro ?repair(?!®)", "flags": "gi", "say": "microRepair® – именно так, со знаком ®" },
    { "brand": "biorepair", "level": "warn", "group": "Оформление", "pattern": "(?<=[а-яё,] )(Вы|Вас|Вам|Ваш[а-яё]*)(?![а-яё])", "flags": "gu", "say": "«вы» со строчной буквы" },

