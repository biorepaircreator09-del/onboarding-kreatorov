    { "brand": "biorepair", "level": "warn", "group": "Стоп-слова Biorepair®", "pattern": "уникальн[а-яё]*", "say": "«запатентованные частицы microRepair®», «особенные» – только если подтверждено" },
    { "brand": "biorepair", "level": "warn", "group": "Стоп-слова Biorepair®", "pattern": "газировк[а-яё]*", "say": "газированные напитки, лимонад" },
    { "brand": "biorepair", "level": "warn", "group": "Стоп-слова Biorepair®", "pattern": "\\d+[,.]?\\d*\\s?%", "say": "проценты публикуются только подтверждённые. Процент microRepair® – никогда" },
